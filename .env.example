# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=app:

# Socket.io Configuration
SOCKET_CORS_ORIGIN=*
SOCKET_AUTH_REQUIRED=false

# Logging
LOG_LEVEL=debug

# SIP Configuration
SIP_DOMAIN=localhost
SIP_UDP_PORT=5060
SIP_TCP_PORT=5060
SIP_TLS_PORT=5061
SIP_WSS_PORT=8443
SIP_TLS_CERT=
SIP_TLS_KEY=
SIP_REALM=sip-proxy
SIP_SERVER_NAME=SIP-Proxy/1.0
SIP_LOG_MESSAGES=true
